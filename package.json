{
  "name": "nexus-community-project",
  "version": "1.0.0",
  "description": "Privacy-first, local-only student hub",
  "main": "index.js",
  "scripts": {
    "start": "PORT=5000 CI=false HOST=0.0.0.0 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "build": "react-scripts build",
    "serve": "npm run build && python3 -m http.server 3000 --directory build",
    "dev": "PORT=5000 CI=false HOST=0.0.0.0 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "py:ai": "cd python-backend && uvicorn main:app --host 127.0.0.1 --port 5001 --reload",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "aas": "node aas-server.js",
    "aas:test": "node aas-server.js",
    "mc:prepare:1122": "node scripts/minecraft-browser/prepare-classpath.js 1.12.2",
    "mc:prepare": "node scripts/minecraft-browser/prepare-classpath.js",
    "mc:fetch-libs:1122": "node scripts/minecraft-browser/fetch-missing-libraries.js 1.12.2",
    "mc:decompile:1122": "bash scripts/minecraft-browser/decompile-minecraft.sh 1.12.2",
    "mc:source-next:1122": "bash scripts/minecraft-browser/next-steps-source-pipeline.sh 1.12.2",
    "mc:overlay:1122": "bash scripts/minecraft-browser/prepare-source-overlay.sh 1.12.2",
    "mc:overlay": "bash scripts/minecraft-browser/prepare-source-overlay.sh",
    "mc:compile-slice:1122": "bash scripts/minecraft-browser/compile-overlay-slice.sh 1.12.2",
    "mc:compile-slice": "bash scripts/minecraft-browser/compile-overlay-slice.sh",
    "mc:compile-targets:1122": "bash scripts/minecraft-browser/compile-overlay-targets.sh 1.12.2 cii",
    "mc:compile-targets": "bash scripts/minecraft-browser/compile-overlay-targets.sh",
    "mc:gates:1122": "bash scripts/minecraft-browser/run-dev-gates.sh 1.12.2 all",
    "mc:gates:baseline:1122": "bash scripts/minecraft-browser/run-dev-gates.sh 1.12.2 baseline",
    "mc:gates:baseline:1122:broad": "MC_BASELINE_TARGETS='bib cii' bash scripts/minecraft-browser/run-dev-gates.sh 1.12.2 baseline",
    "mc:gates:teavm:1122": "bash scripts/minecraft-browser/run-dev-gates.sh 1.12.2 teavm",
    "mc:gates:isolate:1122": "bash scripts/minecraft-browser/run-dev-gates.sh 1.12.2 isolate",
    "mc:bootstrap:1122": "bash scripts/minecraft-browser/create-teavm-bootstrap.sh 1.12.2",
    "mc:phases:1122": "bash scripts/minecraft-browser/run-all-phases.sh 1.12.2",
    "mc:teavm:1122": "bash scripts/minecraft-browser/run-teavm-attempt.sh 1.12.2",
    "mc:teavm:1122:java17": "JAVA_CMD=$(bash scripts/minecraft-browser/find-java17.sh) bash scripts/minecraft-browser/run-teavm-attempt.sh 1.12.2",
    "mc:teavm:log:1122": "[ -f build/minecraft-browser/1.12.2/teavm-run.log ] && tail -n 200 build/minecraft-browser/1.12.2/teavm-run.log || echo 'No TeaVM log yet (run did not start compile stage).'",
    "mc:teavm:meta:1122": "[ -f build/minecraft-browser/1.12.2/teavm-run.meta ] && cat build/minecraft-browser/1.12.2/teavm-run.meta || echo 'No TeaVM metadata yet.'",
    "mc:teavm:exit:1122": "[ -f build/minecraft-browser/1.12.2/teavm-run.exitcode ] && cat build/minecraft-browser/1.12.2/teavm-run.exitcode || echo 'No TeaVM exit code yet.'",
    "mc:teavm:isolate:1122": "bash scripts/minecraft-browser/isolate-teavm-crash.sh 1.12.2",
    "mc:teavm:isolate:1122:java17": "JAVA_CMD=$(bash scripts/minecraft-browser/find-java17.sh) bash scripts/minecraft-browser/isolate-teavm-crash.sh 1.12.2"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "clsx": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.12.0",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "tailwind-merge": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.21",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.2.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}