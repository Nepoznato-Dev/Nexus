# AAS (Advanced AI System) Configuration
# Copy this to .env and fill in your actual keys

# Google Gemini API (REQUIRED for full functionality)
# Get free key: https://aistudio.google.com/app/apikey
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API (Optional - fallback if Google fails)
# Get key: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Server configuration
PORT=3001
NODE_ENV=development

# Optional: AI Personality preferences
AI_PERSONALITY=mentor
AI_MENTORSHIP_LEVEL=0.8
AI_PROFESSIONALISM=0.5
